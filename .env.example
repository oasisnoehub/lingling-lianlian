# Copy to .env and fill in real values. Never commit .env.

# Port the Express server listens on
PORT=3456

# SQLite database directory (Docker volume: lingling-data)
DATA_DIR=/app/data

# Uploaded media directory (Docker volume: lingling-uploads)
UPLOADS_DIR=/app/uploads

# Comma-separated list of allowed browser origins, e.g. https://example.com
CORS_ORIGIN=http://localhost:5173

# Amap (Gaode) Web Service key, used by GET /api/location/reverse.
# Get one at https://console.amap.com/dev/key/app
AMAP_KEY=

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
AUTH_SECRET=

# Per-person unlock passwords. These used to be hard-coded in the frontend and
# are checked by the server now.
PERSON_A_PASSWORD=
PERSON_B_PASSWORD=

# Nightly backup. Backups are written to their own volume (BACKUP_DIR), never
# inside DATA_DIR -- a backup inside the volume it protects is worthless if
# that volume is what gets lost.
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=30
# Photos are much larger than the database, so they are pruned sooner.
BACKUP_UPLOADS_KEEP_DAYS=7
